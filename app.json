{
  "expo": {
    "name": "Cofre Digital",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cofredigital",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tiago.cofredigital",
      "infoPlist": {
        "NSCameraUsageDescription": "Usado para ler boletos e fotografar comprovantes.",
        "NSPhotoLibraryUsageDescription": "Usado para fotos de comprovantes.",
        "NSLocationWhenInUseUsageDescription": "Usado para lembretes baseados na sua localização.",
        "NSLocationAlwaysUsageDescription": "Cofre Digital usa sua localização para verificar locais próximos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1565C0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.tiago.cofredigital"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1565C0"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera para ler boletos e fotografar comprovantes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar suas fotos para comprovantes.",
          "cameraPermission": "Precisamos da câmera para fotografar comprovantes."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usado para lembretes baseados na sua localização.",
          "locationAlwaysAndWhenInUsePermission": "Cofre Digital usa sua localização para verificar locais próximos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bafff62-af36-49b4-9161-2f4a30ab67f2"
      }
    }
  }
}
