{
  "name": "cofre-digital-backend",
  "version": "1.0.0",
  "description": "Backend for Cofre Digital app",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "db:start": "powershell -ExecutionPolicy Bypass -File ./scripts/start-local-postgres.ps1",
    "db:stop": "powershell -ExecutionPolicy Bypass -File ./scripts/stop-local-postgres.ps1",
    "dev:db": "npm run db:start && npm run dev",
    "build": "tsc",
    "test": "jest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "pg": "^8.9.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.19.130",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.2"
  }
}
